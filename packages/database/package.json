{
  "name": "@eoda/database",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./seed-data": "./src/seed-data.ts",
    "./seed-steps": "./src/seed-steps.ts",
    "./document-types": "./src/document-types.ts",
    "./document-folders": "./src/document-folders.ts",
    "./objective-labels": "./src/objective-labels.ts",
    "./restricted-document-types": "./src/restricted-document-types.ts",
    "./restricted-content-purge": "./src/restricted-content-purge.ts"
  },
  "scripts": {
    "generate": "node scripts/generate-migration-manifest.mjs && prisma generate",
    "typecheck": "tsc --noEmit",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "labels:strip-objectives": "tsx scripts/strip-objective-labels.ts",
    "documents:purge-restricted-content": "tsx scripts/purge-restricted-document-content.ts",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
