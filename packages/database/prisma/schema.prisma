// Schéma Prisma V1 — EODA Conseil
// Source de vérité : specs/02-architecture-technique.md
// Ne jamais hardcoder les règles de cotation ici — passer par HasReferentialVersion

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // Pooler Prisma Postgres — requêtes runtime
  directUrl = env("DIRECT_URL")     // Connexion directe — migrations uniquement
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CABINET_ADMIN
  CABINET_EVALUATOR
  CLIENT_USER
}

enum EstablishmentType {
  SAD_AIDE
  SAD_MIXTE
}

enum ProspectStatus {
  NOUVEAU
  RDV
  DEVIS_ENVOYE
  NEGOCIATION
  SIGNE
  PERDU
}

// Statut juridique de la structure. Sert AUX DEUX modèles — Prospect (avant
// signature) et Establishment (après) — d'où le nom neutre : l'appeler ProspectType
// sur une fiche client serait trompeur.
//
// ⚠️ À ne jamais fusionner avec `EstablishmentType` (SAD_AIDE / SAD_MIXTE). Ce sont
// deux axes indépendants : une association loi 1901 peut être un SAD Aide OU un SAD
// Mixte. Le support commercial les aligne sur une même ligne (« SAD Aide · SAD Mixtes
// · Associations loi 1901 · CCAS/CIAS · Secteur privé ») — c'est une liste de segments
// de marché, pas un enum. Les fusionner rendrait la moitié des combinaisons
// inexprimables (cf. CLAUDE.md §7).
enum StructureType {
  // Association loi 1901
  ASSOCIATION
  // Secteur privé
  PRIVE
  // CCAS / CIAS et autres organismes publics
  PUBLIC
}

// Civilité du contact — champ à part et non préfixe du nom. Recopier « Madame »
// dans `contactName` rend le nom inexploitable : impossible de trier, d'adresser un
// courrier ou de pré-remplir un devis sans le redécouper à la main.
enum Civility {
  MONSIEUR
  MADAME
  MADEMOISELLE
}

// Fonction du contact dans la structure. Liste volontairement courte, à compléter au
// fur et à mesure des rôles réellement rencontrés en prospection ; `AUTRE` + précision
// libre évite d'avoir à migrer le schéma à chaque cas nouveau.
enum ContactRole {
  DIRECTION
  COORDINATION
  ASSISTANAT
  AUTRE
}

// ─────────────────────────────────────────────────────────────────────────────
// AGENDA — rendez-vous du cabinet et points programmés avec le client
// ─────────────────────────────────────────────────────────────────────────────

// Nature du rendez-vous. Les trois premiers sont les étapes de vente nommées par
// Sandrine (call du 26/08) : R0 prise de contact, R1 découverte, R2 accord de
// principe. Les suivants appartiennent à l'accompagnement.
enum AppointmentKind {
  R0_PRISE_CONTACT
  R1_DECOUVERTE
  R2_ACCORD
  REUNION_CADRAGE
  VISITE
  ATELIER
  REUNION_SUIVI
  RESTITUTION
  AUTRE
}

// Comment on se voit. Porté par le rendez-vous et non déduit du lieu : « visio »
// avec une adresse saisie est un cas réel (salle de réunion + lien de secours).
enum AppointmentMode {
  VISIO
  PRESENTIEL
  TELEPHONE
}

// Le planning est PRÉVISIONNEL par défaut : « je fais des propositions qu'il valide
// à chaque fois » (call du 26/08). Un créneau proposé n'est pas un créneau tenu, et
// l'afficher comme ferme au client ferait annuler des rendez-vous qui n'existaient
// pas.
enum AppointmentStatus {
  PROPOSE
  CONFIRME
  ANNULE
}

enum AcquisitionChannel {
  BOUCHE_A_OREILLE
  REFERENCEMENT_UNA
  EMAILING
  REFERENCEMENT_GOOGLE
  LINKEDIN
  AUTRE
}

// Nature d'une entrée d'historique de prospect. Deux natures seulement, et elles ne
// se confondent pas : un commentaire est saisi par quelqu'un, un changement de statut
// est constaté par l'outil. Les fusionner en « note » ferait disparaître la
// chronologie commerciale dans du texte libre.
enum ProspectTimelineKind {
  COMMENTAIRE
  CHANGEMENT_STATUT
}

enum DevisStatus {
  BROUILLON
  ENVOYE
  SIGNE
  REFUSE
  // Devis annulé APRÈS émission (envoyé ou signé). La ligne et son numéro sont
  // conservés : la série DEVIS-AAAA-NNN est une numérotation commerciale, elle ne
  // doit jamais comporter de trou. Un brouillon, lui, se supprime réellement —
  // rien de commercial ne s'est produit et son numéro n'a jamais circulé.
  //
  // Pourquoi une valeur d'enum plutôt qu'une colonne `annulled_at` : le statut est
  // le seul champ sur lequel toute l'application branche déjà (badge, transitions,
  // filtres KPI). Un horodatage parallèle créerait une seconde source de vérité que
  // chaque `status === "SIGNE"` existant ignorerait en silence — un devis annulé
  // continuerait de gonfler le CA signé. Avec une valeur d'enum, les `Record<DevisStatus, …>`
  // du dépôt cessent de compiler tant que le nouveau cas n'est pas traité :
  // le compilateur devient le contrôle mécanique (règle zéro).
  ANNULE
}

enum MissionChecklistScope {
  DIAGNOSTIC
  FONDATIONS
  DEPLOIEMENT
  CONSOLIDATION
  PREPARATION_FINALE
}

enum CommercialTier {
  BETA
  ESSENTIEL
  PERFORMANCE
  EXCELLENCE
}

// Unité de tarification d'une prestation à la carte — offre commerciale v10 §04.
// Tous les prix du catalogue sont des prix « à partir de » (règle de gouvernance
// produit, context/07-outil-pilotage-missions.md §12.3) : l'unité ne change pas ce
// statut, elle indique seulement à quoi le montant se rapporte.
enum PricingUnit {
  FORFAIT // montant global pour la prestation (ex. audit flash 1 jour)
  HEURE // ex. mise à jour documentaire 95 à 120 € / h
  JOUR
  DOCUMENT // ex. procédure clé en main 250 € / procédure
  SUPPORT // ex. outil de sensibilisation 300 € / support
  MOIS // abonnement récurrent, ex. portail + veille 400 € / mois
}

// Cycle de vie d'une demande de devis d'option émise depuis le portail client.
// Règle §12.3 : le client DEMANDE, Sandrine déclenche. Aucun statut ici ne débloque
// quoi que ce soit — le déblocage passe par un devis puis un avenant (§12.6).
enum OptionRequestStatus {
  DEMANDEE
  TRAITEE
  REFUSEE
}

enum EstablishmentUserRole {
  DIRECTEUR
  COORDINATEUR
  ASSISTANT_QUALITE
  AUTRE
}

enum RequirementLevel {
  IMPERATIF
  STANDARD
}

enum ApplicableTo {
  SAD_AIDE
  SAD_MIXTE
  BOTH
}

enum DocumentCategory {
  LOI_2002_2
  FONCTIONNEMENT
  QUALITE_RISQUES
  RH
}

enum DocumentStatus {
  MISSING
  UPLOADED
  ANALYZING
  INCOMPLETE
  COMPLIANT
  EXPIRED
  NOT_APPLICABLE
}

enum ExpectedFrequency {
  ANNUAL
  BIANNUAL
  TRIENNIAL
  ON_DEMAND
}

enum Rating {
  R1
  R2
  R3
  R4
  STAR
  NC
  RI
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANISATION
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id            String          @id @default(cuid())
  name          String
  createdAt     DateTime        @default(now()) @map("created_at")
  users         User[]
  establishments Establishment[]

  catalogueFormules CatalogueFormule[]
  catalogueOptions  CatalogueOption[]
  billingSettings   BillingSettings?
  devisCounters     DevisCounter[]
  prospects         Prospect[]
  devis             Devis[]
  missions          Mission[]
  optionRequests    ClientOptionRequest[]
  prospectTimeline  ProspectTimelineEntry[]
  appointments      Appointment[]
  missionMessages   MissionMessage[]
  templateDocuments TemplateDocument[]

  @@map("tenants")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String?   @map("tenant_id")
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         UserRole  @default(CLIENT_USER)
  createdAt    DateTime  @default(now()) @map("created_at")

  // Rotation du mot de passe. Un compte client est créé avec un mot de passe
  // temporaire affiché une seule fois : tant que ce drapeau est vrai, la couche
  // d'autorisation (lib/auth/guards.ts) n'ouvre aucune autre route que la page de
  // changement. Voir specs/02-architecture-technique.md §4.10.
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  // Sert aussi d'horodatage de révocation : toute session ouverte AVANT cette date
  // est refusée par les gardes (invalidation des sessions concurrentes).
  passwordChangedAt  DateTime? @map("password_changed_at")

  // Révocation d'un compte sans le supprimer (départ d'un salarié de la structure
  // cliente, suspension d'accès). Un compte inactif est refusé À LA CONNEXION et à
  // chaque contrôle d'autorisation (lib/auth/guards.ts) — jamais seulement masqué
  // dans une liste. Réversible : la réactivation repose le drapeau.
  isActive           Boolean   @default(true) @map("is_active")
  deactivatedAt      DateTime? @map("deactivated_at")

  tenant             Tenant?              @relation(fields: [tenantId], references: [id])
  establishmentUsers EstablishmentUser[]
  uploadedVersions   DocumentVersion[]    @relation("UploadedBy")
  evaluationSessions EvaluationSession[]
  optionRequests     ClientOptionRequest[] @relation("RequestedBy")
  prospectTimeline   ProspectTimelineEntry[] @relation("ProspectTimelineAuthor")
  reviewedAnalyses   DocumentVersion[]       @relation("AnalysisReviewedBy")
  createdAppointments Appointment[]          @relation("AppointmentCreatedBy")
  validatedDocuments  Document[]             @relation("DocumentValidatedBy")
  missionMessages     MissionMessage[]
  uploadedTemplates   TemplateVersion[]      @relation("TemplateUploadedBy")

  @@index([tenantId])
  @@map("users")
}

model Establishment {
  id                    String            @id @default(cuid())
  tenantId              String            @map("tenant_id")
  name                  String
  finessNumber          String?           @unique @map("finess_number")
  // SIRET — identifiant au registre des entreprises, mention obligatoire sur un
  // devis, un contrat et une facture. Distinct du FINESS, qui identifie l'ESSMS
  // auprès des autorités sanitaires : les deux coexistent, aucun ne remplace l'autre.
  //
  // PAS @unique, contrairement au FINESS, et c'est délibéré : le FINESS est déjà la
  // clé qui interdit deux fiches pour la même structure, et il a fallu un service
  // dédié pour que sa violation ne soit pas avalée par le `catch` général de la
  // conversion. Une seconde contrainte unique ouvrirait un second chemin d'échec à la
  // signature, pour un gain nul — l'unicité est déjà obtenue.
  siretNumber           String?           @map("siret_number")
  // Type de service rendu — axe INDÉPENDANT du statut juridique ci-dessous.
  type                  EstablishmentType
  // Statut juridique. Nullable en base et pourtant exigé à la saisie : les fiches
  // créées avant cette colonne n'en ont pas, et aucune valeur par défaut ne serait
  // vraie. Inventer « ASSOCIATION » pour tout le monde ferait entrer une donnée
  // fausse dans un livrable client — mieux vaut un « non renseigné » visible qui
  // appelle une correction.
  structureType         StructureType?    @map("structure_type")
  address               String?

  // LOGO DE LA STRUCTURE — apposé, à côté de celui d'EODA, sur les documents que la
  // plateforme produit pour elle (call du 26/08 : « d'un côté il y a mon logo, pour
  // dire que c'est un document que j'ai créé, et de l'autre le logo de l'entreprise à
  // qui c'est destiné »).
  //
  // Stocké en data URI, et pas dans le bucket : une image de moins de 300 Ko, lue
  // uniquement au rendu d'un document, n'a pas besoin d'une route de service ni d'un
  // contrôle d'accès de plus. Elle voyage avec la page qui l'affiche — y compris à
  // l'impression, où une URL signée expirée donnerait un carré vide sur un document
  // remis au client.
  logoDataUri           String?           @map("logo_data_uri")
  // Historique/affichage uniquement — non éditable via l'UI. La formule qui fait
  // autorité pour le périmètre d'accompagnement réellement contracté est
  // Mission.formule (cf. section PIPELINE COMMERCIAL / SUIVI DE MISSION plus bas).
  commercialTier        CommercialTier    @default(BETA) @map("commercial_tier")
  hasEvaluationTargetDate DateTime?       @map("has_evaluation_target_date")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  establishmentUsers EstablishmentUser[]
  documents          Document[]
  evaluationSessions EvaluationSession[]
  prospect           Prospect?
  mission            Mission?
  optionRequests     ClientOptionRequest[]
  appointments       Appointment[]
  messages           MissionMessage[]

  @@index([tenantId])
  @@map("establishments")
}

model EstablishmentUser {
  userId              String                @map("user_id")
  establishmentId     String                @map("establishment_id")
  roleInEstablishment EstablishmentUserRole @map("role_in_establishment")

  user          User          @relation(fields: [userId], references: [id])
  establishment Establishment @relation(fields: [establishmentId], references: [id])

  @@id([userId, establishmentId])
  @@index([establishmentId])
  @@map("establishment_users")
}

// ─────────────────────────────────────────────────────────────────────────────
// RÉFÉRENTIEL HAS (seed uniquement — jamais modifié manuellement en prod)
// ─────────────────────────────────────────────────────────────────────────────

model HasReferentialVersion {
  id            String   @id @default(cuid())
  label         String   // ex: "Manuel HAS juillet 2025"
  effectiveDate DateTime @map("effective_date")
  chapters      Chapter[]

  @@map("has_referential_versions")
}

model Chapter {
  id                   String                @id @default(cuid())
  referentialVersionId String                @map("referential_version_id")
  number               Int
  name                 String
  method               String                // "Accompagné traceur" | "Traceur ciblé" | "Audit système"

  referentialVersion HasReferentialVersion @relation(fields: [referentialVersionId], references: [id])
  themes             Theme[]
  evaluationSessions EvaluationSession[]

  @@index([referentialVersionId])
  @@map("chapters")
}

model Theme {
  id        String @id @default(cuid())
  chapterId String @map("chapter_id")
  code      String // ex: "3.1" — clé stable pour le seed idempotent (colonne "ID Thématique")
  name      String

  chapter    Chapter     @relation(fields: [chapterId], references: [id])
  objectives Objective[]

  @@unique([chapterId, code])
  @@map("themes")
}

model Objective {
  id            String  @id @default(cuid())
  themeId       String  @map("theme_id")
  code          String  // ex: "2.2"
  weightPercent Float?  @map("weight_percent") // pondération future — lire via ScoringService

  theme    Theme      @relation(fields: [themeId], references: [id])
  criteria Criterion[]

  @@unique([themeId, code])
  @@map("objectives")
}

model Criterion {
  id               String           @id @default(cuid())
  objectiveId      String           @map("objective_id")
  code             String           @unique // ex: "2.2.7"
  label            String
  requirementLevel RequirementLevel @map("requirement_level")
  applicableTo     ApplicableTo     @map("applicable_to")

  objective          Objective              @relation(fields: [objectiveId], references: [id])
  evaluationElements EvaluationElement[]
  documentTypes      DocumentTypeCriterion[]

  @@index([objectiveId])
  @@map("criteria")
}

model EvaluationElement {
  id                  String  @id @default(cuid())
  criterionId         String  @map("criterion_id")
  originalText        String  @map("original_text")
  reformulatedText    String? @map("reformulated_text")
  // true uniquement si chapter.number == 1 — vérifier avant d'autoriser RI dans l'UI
  allowsRi            Boolean @default(false) @map("allows_ri")
  // UUID stable de la colonne "ID Question" des grilles Synaé source — permet un seed
  // idempotent (upsert) plutôt que de dupliquer les E.E. à chaque re-seed.
  sourceQuestionId    String? @unique @map("source_question_id")

  criterion   Criterion      @relation(fields: [criterionId], references: [id])
  elementRatings ElementRating[]

  @@index([criterionId])
  @@map("evaluation_elements")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULES 1 & 2 — DOCUMENTS
// ─────────────────────────────────────────────────────────────────────────────

model DocumentType {
  id                String            @id @default(cuid())
  code              String            @unique // ex: "L2002_DIPC", "P13_FICHE_DECLARATION"
  category          DocumentCategory
  label             String
  isConditional     Boolean           @default(false) @map("is_conditional")
  expectedFrequency ExpectedFrequency? @map("expected_frequency")

  // RÉCLAMÉ AU CLIENT, ou PRODUIT PAR EODA.
  //
  // « Ce ne sont pas des documents qu'ils doivent fournir […] c'est à moi de les
  // créer pour eux » (call du 26/08). Sur 29 types attendus, cinq seulement sont
  // réclamés à la structure avant la visite d'évaluation ; tout le reste est ce que
  // l'accompagnement produit. Demander les 29 à quelqu'un qui fait appel à nous
  // précisément parce qu'il ne les a pas, c'est lui remettre notre travail.
  //
  // Défaut `false` : on ne réclame rien par défaut. Le portail client n'affiche que
  // les types réclamés — et ceux pour lesquels un document existe déjà, qui restent
  // sa bibliothèque.
  requestedFromClient Boolean         @default(false) @map("requested_from_client")

  documents DocumentTypeCriterion[]
  Document  Document[]

  @@map("document_types")
}

model DocumentTypeCriterion {
  documentTypeId String @map("document_type_id")
  criterionId    String @map("criterion_id")

  documentType DocumentType @relation(fields: [documentTypeId], references: [id])
  criterion    Criterion    @relation(fields: [criterionId], references: [id])

  @@id([documentTypeId, criterionId])
  @@index([criterionId])
  @@map("document_type_criteria")
}

model Document {
  id                     String         @id @default(cuid())
  establishmentId        String         @map("establishment_id")
  documentTypeId         String?        @map("document_type_id")
  currentVersionId       String?        @unique @map("current_version_id")
  status                 DocumentStatus @default(MISSING)
  statusOverriddenByUser Boolean        @default(false) @map("status_overridden_by_user")
  // Réponse Oui/Non + commentaire libre quand le document n'est pas encore déposé —
  // utilisable comme élément de preuve pour la cotation (Module 3). cf. plan Phase 0.
  missingJustification   String?        @map("missing_justification")

  // VALIDATION — dernière étape du parcours documentaire décrit par Sandrine le
  // 26/08 : déposé → analysé → mis en conformité → restitué → VALIDÉ.
  //
  // Les quatre premières étapes se DÉRIVENT de faits déjà là (une version existe,
  // une analyse existe, une version corrigée existe, l'analyse a été relue). La
  // cinquième, non : valider, c'est engager la parole de l'évaluatrice sur un
  // document qui partira à la HAS. C'est une décision, comme la clôture d'une
  // mission — donc un fait stocké.
  validatedAt            DateTime?      @map("validated_at")
  validatedByUserId      String?        @map("validated_by_user_id")

  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  establishment  Establishment    @relation(fields: [establishmentId], references: [id])
  documentType   DocumentType?    @relation(fields: [documentTypeId], references: [id])
  currentVersion DocumentVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions       DocumentVersion[] @relation("AllVersions")
  // SetNull : la désactivation d'un compte ne dévalide pas un document déjà validé.
  validatedBy    User?            @relation("DocumentValidatedBy", fields: [validatedByUserId], references: [id], onDelete: SetNull)

  @@unique([establishmentId, documentTypeId])
  @@index([documentTypeId])
  @@map("documents")
}

model DocumentVersion {
  id                          String   @id @default(cuid())
  documentId                  String   @map("document_id")
  versionNumber               Int      @map("version_number")
  fileStorageKey              String   @map("file_storage_key")
  originalFilename            String   @map("original_filename")
  uploadedByUserId            String   @map("uploaded_by_user_id")
  uploadedAt                  DateTime @default(now()) @map("uploaded_at")
  extractedText               String?  @map("extracted_text")
  analysisResultJson          Json?    @map("analysis_result_json")

  // REVUE HUMAINE DE L'ANALYSE — exigence du cahier des charges (§5 et §7 du CDC
  // du 20/08/2026, écrite deux fois) : « aucune analyse de conformité automatisée
  // ne doit être présentée au client sans revue préalable de la consultante ».
  //
  // Tant que ce champ est null, l'analyse existe, elle est visible du CABINET, et
  // le portail client ne la montre pas. Ce n'est pas un réglage d'affichage : c'est
  // la frontière entre une aide au travail de Sandrine et une restitution au client.
  //
  // Fait stocké et non dérivé, pour la même raison que Mission.closedAt : une revue
  // est une décision humaine, elle ne se calcule pas.
  analysisReviewedAt          DateTime? @map("analysis_reviewed_at")
  analysisReviewedByUserId    String?   @map("analysis_reviewed_by_user_id")
  regeneratedFromVersionId    String?  @map("regenerated_from_version_id")

  document                Document  @relation("AllVersions", fields: [documentId], references: [id])
  uploadedBy              User      @relation("UploadedBy", fields: [uploadedByUserId], references: [id])
  // SetNull : la désactivation d'un compte ne doit pas dépublier une analyse déjà
  // restituée au client.
  analysisReviewedBy      User?     @relation("AnalysisReviewedBy", fields: [analysisReviewedByUserId], references: [id], onDelete: SetNull)
  regeneratedFromVersion  DocumentVersion?  @relation("Regeneration", fields: [regeneratedFromVersionId], references: [id])
  regeneratedVersions     DocumentVersion[] @relation("Regeneration")
  currentForDocument      Document?         @relation("CurrentVersion")

  @@index([documentId])
  @@map("document_versions")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 3 — AUTO-ÉVALUATION HAS
// ─────────────────────────────────────────────────────────────────────────────

model EvaluationSession {
  id                String    @id @default(cuid())
  establishmentId   String    @map("establishment_id")
  chapterId         String    @map("chapter_id")
  startedAt         DateTime  @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  durationSeconds   Int?      @map("duration_seconds")
  performedByUserId String    @map("performed_by_user_id")

  establishment Establishment  @relation(fields: [establishmentId], references: [id])
  chapter       Chapter        @relation(fields: [chapterId], references: [id])
  performedBy   User           @relation(fields: [performedByUserId], references: [id])
  elementRatings ElementRating[]

  @@index([chapterId])
  @@index([establishmentId])
  @@map("evaluation_sessions")
}

model ElementRating {
  id                  String  @id @default(cuid())
  evaluationSessionId String  @map("evaluation_session_id")
  evaluationElementId String  @map("evaluation_element_id")
  rating              Rating
  comment             String? // preuve consultée
  suggestedBySystem   Boolean @default(false) @map("suggested_by_system")
  confirmedByUser     Boolean @default(false) @map("confirmed_by_user")
  ratedAt             DateTime @default(now()) @map("rated_at")

  evaluationSession EvaluationSession @relation(fields: [evaluationSessionId], references: [id])
  evaluationElement EvaluationElement @relation(fields: [evaluationElementId], references: [id])

  @@unique([evaluationSessionId, evaluationElementId])
  @@index([evaluationElementId])
  @@map("element_ratings")
}

// ─────────────────────────────────────────────────────────────────────────────
// PIPELINE COMMERCIAL — Prospects, Devis, Catalogue (CABINET_ADMIN uniquement)
// Hors périmètre : suivi de mission (checklist diagnostic + 4 phases) — cf.
// context/07-outil-pilotage-missions.md §7, non traité dans cette itération.
// Montants stockés en euros entiers (Int) — pas de tarification fractionnaire
// dans le catalogue actuel, cf. context/07-outil-pilotage-missions.md §4.
// ─────────────────────────────────────────────────────────────────────────────

model CatalogueFormule {
  id           String         @id @default(cuid())
  tenantId     String         @map("tenant_id")
  formule      CommercialTier
  label        String
  priceEuros   Int            @map("price_euros")
  modulesLabel String?        @map("modules_label")
  description  String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  devis  Devis[]

  @@unique([tenantId, formule])
  @@map("catalogue_formules")
}

model CatalogueOption {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  code     String
  label    String
  // Borne basse du prix « à partir de » — toujours exprimée dans l'unité `pricingUnit`.
  priceEuros Int         @map("price_euros")
  pricingUnit PricingUnit @default(FORFAIT) @map("pricing_unit")
  // Borne haute d'une fourchette (ex. « 95 à 120 € / h »). null = pas de fourchette.
  priceMaxEuros Int? @map("price_max_euros")
  // Quantité minimale facturable, dans l'unité ci-dessus : 2 pour « mini. 2 h »,
  // 12 pour un abonnement mensuel à engagement d'un an. null = pas de minimum.
  minQuantity Int?     @map("min_quantity")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  devisOptions   DevisOption[]
  missionOptions MissionOption[]
  clientRequests ClientOptionRequest[]

  @@unique([tenantId, code])
  @@map("catalogue_options")
}

model BillingSettings {
  id                    String   @id @default(cuid())
  tenantId              String   @unique @map("tenant_id")
  // 40 % à la commande — CGP de l'offre commerciale v10 §06 (auparavant 30 %).
  defaultDepositPercent Int      @default(40) @map("default_deposit_percent")
  defaultValidityDays   Int      @default(30) @map("default_validity_days")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("billing_settings")
}

// Compteur annuel de numérotation devis (DEVIS-AAAA-NNN) — une ligne par
// (tenant, année), incrémentée uniquement à la création d'un devis, jamais
// à sa modification. cf. context/07-outil-pilotage-missions.md §6.2
model DevisCounter {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  year     Int
  value    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, year])
  @@map("devis_counters")
}

model Prospect {
  id                   String             @id @default(cuid())
  tenantId             String             @map("tenant_id")
  structureName        String             @map("structure_name")
  structureType        StructureType      @map("structure_type")
  civility             Civility?
  contactName          String?            @map("contact_name")
  contactRole          ContactRole?       @map("contact_role")
  // Précision obligatoire quand `contactRole = AUTRE` — sinon la valeur « Autre »
  // ne dit rien de plus que l'absence de valeur. Même règle pour `channelOther`.
  contactRoleOther     String?            @map("contact_role_other")
  contactPhone         String?            @map("contact_phone")
  contactEmail         String?            @map("contact_email")
  channel              AcquisitionChannel
  // « Comment nous ont-ils connus ? » quand aucun canal listé ne convient. Sans ce
  // champ, `AUTRE` est un trou noir : il enregistre qu'on ne sait pas, et l'analyse
  // d'acquisition perd exactement les cas nouveaux qu'il faudrait repérer.
  channelOther         String?            @map("channel_other")
  status               ProspectStatus     @default(NOUVEAU)
  envisagedFormule     CommercialTier?    @map("envisaged_formule")
  estimatedAmountEuros Int?               @map("estimated_amount_euros")
  firstContactDate     DateTime           @map("first_contact_date")
  // Évaluation des besoins (Phase 0 — étape "Évaluation des besoins" de la prospection) —
  // notes qualitatives ; `estimatedAmountEuros` ci-dessus sert de niveau financier.
  // IDENTITÉ DE LA STRUCTURE, connue dès le premier contact et saisie une seule fois.
  //
  // Ces quatre champs se saisissaient jusqu'ici seulement à la SIGNATURE : on les
  // avait sous les yeux en réunion de découverte sans pouvoir les noter, et il
  // fallait les retrouver des semaines plus tard. Ils sont donc FACULTATIFS ici (un
  // prospect dont on ne connaît que le nom et un téléphone doit pouvoir entrer dans
  // le pipeline) et RECOPIÉS sur la fiche à la signature — même règle que
  // `structureType`.
  //
  // `finessNumber` n'est PAS unique ici, contrairement à `Establishment.finessNumber` :
  // deux prospects peuvent désigner la même structure pendant une prospection, et
  // c'est la création de la FICHE qui doit trancher. La contrainte reste donc là où
  // elle a un sens.
  finessNumber         String?            @map("finess_number")
  // Voir Establishment.siretNumber. Facultatif ici comme le reste de l'identité : la
  // personne qui appelle peut être une assistante de direction qui ne l'a pas.
  siretNumber          String?            @map("siret_number")
  address              String?
  // Type de SAD. Reste DEMANDÉ à la signature (CLAUDE.md §7 — jamais déduit de la
  // forme juridique) : ce champ ne fait que pré-remplir la question.
  establishmentType    EstablishmentType? @map("establishment_type")
  hasEvaluationTargetDate DateTime?       @map("has_evaluation_target_date")
  needsAssessmentNotes String?            @map("needs_assessment_notes")
  // GRILLE D'ENTRETIEN DÉCOUVERTE — réponses de la réunion de découverte (R1),
  // saisies par le cabinet pendant l'appel. Colonne Json et non vingt colonnes : la
  // grille est un CONTENU versionné (apps/web/src/content/decouverte/), pas un
  // schéma. Ajouter une question ne doit pas demander une migration — le gabarit
  // v03 de Sandrine est attendu, et il remplacera les questions.
  //
  // Lue DÉFENSIVEMENT (discovery-grid-service) : une réponse écrite sous une version
  // antérieure de la grille ne doit pas casser l'écran, et une question disparue ne
  // doit pas réapparaître.
  discoveryAnswersJson Json?              @map("discovery_answers_json")
  discoveryUpdatedAt   DateTime?          @map("discovery_updated_at")
  notes                String?
  // Renseigné par la CONVERSION à la signature (lib/actions/conversion.ts) : passer
  // un devis à SIGNE crée l'Establishment s'il n'existe pas, pose ce lien, et crée
  // la Mission qui porte le périmètre. Plus de saisie manuelle — c'était la charnière
  // manuelle du parcours §12.4 (« le parcours à verrouiller en priorité »).
  // @unique : c'est CETTE contrainte qui interdit qu'un même établissement soit
  // rattaché à deux prospects, et donc qu'une double conversion en fabrique un second.
  establishmentId      String?            @unique @map("establishment_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  // SetNull et non Cascade : supprimer une fiche client ne doit pas effacer
  // l'historique commercial (prospect, devis signés, chiffre d'affaires). Le
  // prospect survit, simplement détaché.
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  devis         Devis[]
  timeline      ProspectTimelineEntry[]
  appointments  Appointment[]

  @@index([tenantId])
  @@map("prospects")
}

// Rendez-vous — la même ligne sert l'avant-vente et l'accompagnement.
//
// Rattaché à un PROSPECT (R0/R1/R2, avant toute signature) ou à un ÉTABLISSEMENT
// (une fois la fiche créée), jamais aux deux. Deux modèles séparés obligeraient
// l'agenda à fusionner deux sources pour répondre à « qu'est-ce que j'ai cette
// semaine ? », et la conversion à recopier des rendez-vous d'une table à l'autre.
model Appointment {
  id              String            @id @default(cuid())
  tenantId        String            @map("tenant_id")
  prospectId      String?           @map("prospect_id")
  establishmentId String?           @map("establishment_id")

  kind    AppointmentKind
  mode    AppointmentMode
  status  AppointmentStatus @default(PROPOSE)

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  // Intitulé lu par le client (« Atelier documentaire — jour 1 »).
  subject String
  // Lien de visioconférence ou adresse du rendez-vous. Un seul champ : la nature du
  // lieu est déjà dite par `mode`, et deux colonnes dont une toujours vide se
  // remplissent de travers.
  location String?
  // Notes de préparation du cabinet. JAMAIS transmises au portail client — c'est la
  // raison d'être du champ séparé de `subject`.
  notes String?

  // Un rendez-vous interne (préparation, point d'équipe) reste hors du portail
  // client. Par défaut visible : l'agenda existe d'abord pour que le client sache
  // quand on se voit.
  visibleToClient Boolean @default(true) @map("visible_to_client")

  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  prospect      Prospect?      @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id])

  // Lecture par défaut de l'agenda : tout le tenant sur une plage de dates.
  @@index([tenantId, startsAt])
  // Les prochains rendez-vous d'un client, côté portail.
  @@index([establishmentId, startsAt])
  @@index([prospectId, startsAt])
  @@map("appointments")
}

// Historique d'un prospect — le dossier que Sandrine reconstituait dans sa boîte
// mail. Commentaires saisis à chaque étape (questions reçues, relances, points
// d'accroche) ET changements de statut, sur la même frise : séparer les deux
// obligerait à lire deux écrans pour répondre à « où en est-on avec eux, et
// pourquoi ? ».
//
// Historique, donc APPEND-ONLY : aucune action de modification ni de suppression
// d'une entrée. Un historique qu'on peut réécrire ne prouve rien.
model ProspectTimelineEntry {
  id           String               @id @default(cuid())
  tenantId     String               @map("tenant_id")
  prospectId   String               @map("prospect_id")
  kind         ProspectTimelineKind
  // Auteur. Nullable et SetNull : la désactivation d'un compte ne doit pas emporter
  // l'historique commercial (même principe que la piste d'audit).
  authorUserId String?              @map("author_user_id")
  // Texte du commentaire. Null pour un changement de statut, qui se raconte avec
  // `statusFrom`/`statusTo` — recopier « passé en Devis envoyé » dans du texte libre
  // le rendrait infalsifiable mais illisible par la machine.
  body         String?
  statusFrom   ProspectStatus?      @map("status_from")
  statusTo     ProspectStatus?      @map("status_to")
  createdAt    DateTime             @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  // Cascade : l'historique n'existe que par son prospect. Un prospect n'est
  // supprimable que sans devis (lib/actions/prospect.ts), donc sans valeur
  // commerciale à conserver.
  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  author   User?    @relation("ProspectTimelineAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  // Lecture par défaut : la frise d'un prospect, du plus récent au plus ancien.
  @@index([prospectId, createdAt])
  @@index([tenantId])
  @@map("prospect_timeline_entries")
}

model Devis {
  id         String      @id @default(cuid())
  tenantId   String      @map("tenant_id")
  prospectId String      @map("prospect_id")
  number     String      @unique
  status     DevisStatus @default(BROUILLON)

  catalogueFormuleId String @map("catalogue_formule_id")
  // Snapshots — figent le libellé/prix de la formule au moment de la création
  // pour qu'une évolution ultérieure du catalogue ne change jamais un devis existant.
  formuleLabelSnapshot      String @map("formule_label_snapshot")
  formulePriceSnapshotEuros Int    @map("formule_price_snapshot_euros")

  depositPercent   Int      @map("deposit_percent")
  installmentCount Int      @map("installment_count")
  validityDays     Int      @map("validity_days")
  validUntil       DateTime @map("valid_until")

  // Montants calculés côté serveur à la création (cf. devis-calculation-service) —
  // jamais recalculés à la lecture ni côté client.
  totalAmountEuros       Int @map("total_amount_euros")
  depositAmountEuros     Int @map("deposit_amount_euros")
  balanceAmountEuros     Int @map("balance_amount_euros")
  installmentAmountEuros Int @map("installment_amount_euros")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  prospect         Prospect         @relation(fields: [prospectId], references: [id])
  catalogueFormule CatalogueFormule @relation(fields: [catalogueFormuleId], references: [id])
  options          DevisOption[]
  missions         Mission[]

  @@index([tenantId])
  @@index([prospectId])
  @@index([catalogueFormuleId])
  @@map("devis")
}

// Ligne d'option cochée sur un devis — snapshot prix/libellé, cf. Devis ci-dessus.
model DevisOption {
  id                 String @id @default(cuid())
  devisId            String @map("devis_id")
  catalogueOptionId  String @map("catalogue_option_id")
  labelSnapshot      String @map("label_snapshot")
  priceSnapshotEuros Int    @map("price_snapshot_euros")
  // L'unité, la borne haute et le minimum font partie du prix : sans eux, une ligne
  // « 95 € » d'un devis imprimé en 2027 ne veut plus rien dire. Snapshotés comme le prix.
  pricingUnitSnapshot   PricingUnit @default(FORFAIT) @map("pricing_unit_snapshot")
  priceMaxSnapshotEuros Int?        @map("price_max_snapshot_euros")
  minQuantitySnapshot   Int?        @map("min_quantity_snapshot")

  devis           Devis           @relation(fields: [devisId], references: [id])
  catalogueOption CatalogueOption @relation(fields: [catalogueOptionId], references: [id])

  @@unique([devisId, catalogueOptionId])
  @@index([catalogueOptionId])
  @@map("devis_options")
}

// Demande de devis pour une option NON souscrite, émise depuis le portail client
// (« Mon accompagnement »). C'est la trace interne du parcours §12.3 : le client
// demande, Sandrine déclenche. Rien ici n'ouvre un droit ni ne débloque une
// fonctionnalité — le déblocage passe par un devis puis un avenant (§12.6).
//
// Pourquoi une table plutôt qu'un simple événement d'audit : une demande a un
// cycle de vie (à traiter → traitée / refusée) et doit être listable et
// actionnable côté Cabinet. Le journal d'audit, lui, est en écriture seule et ne
// se corrige pas — les deux sont écrits, ils ne se remplacent pas.
model ClientOptionRequest {
  id                String              @id @default(cuid())
  tenantId          String              @map("tenant_id")
  establishmentId   String              @map("establishment_id")
  catalogueOptionId String              @map("catalogue_option_id")
  // Auteur de la demande — sert au Cabinet à savoir qui rappeler. Jamais affiché
  // à un autre client : la ligne est lue filtrée par établissement.
  requestedByUserId String              @map("requested_by_user_id")
  status            OptionRequestStatus @default(DEMANDEE)
  // Message libre du client (contexte, volumétrie souhaitée). Borné côté parseur.
  message           String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  handledAt         DateTime?           @map("handled_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  // Cascade : une demande d'option est attachée à l'établissement qui la formule.
  establishment   Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  catalogueOption CatalogueOption @relation(fields: [catalogueOptionId], references: [id])
  requestedBy     User            @relation("RequestedBy", fields: [requestedByUserId], references: [id])

  // File d'attente du Cabinet : les demandes à traiter d'un tenant, du plus ancien
  // au plus récent.
  @@index([tenantId, status, createdAt])
  // Détection d'un doublon en attente pour un couple (établissement, option).
  @@index([establishmentId, catalogueOptionId, status])
  @@index([catalogueOptionId])
  @@map("client_option_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUIVI DE MISSION — checklist diagnostic (12 items) + 4 phases d'accompagnement
// (3+4+4+4 items). cf. context/07-outil-pilotage-missions.md §7.
// Accessible à CABINET_ADMIN et CABINET_EVALUATOR (requireCabinetSession) —
// contrairement au reste du pipeline commercial (prospects/devis/catalogue), qui
// reste réservé à CABINET_ADMIN : ceci est du suivi opérationnel d'accompagnement,
// pas de la donnée financière.
// ─────────────────────────────────────────────────────────────────────────────

// Référentiel fixe de la méthodologie EODA (27 items) — global, non cloisonné par
// tenant, seedé une seule fois (idem DocumentType), non modifiable via l'UI dans
// cette itération. cf. §7.1-§7.2.
model MissionChecklistItem {
  id    String                @id @default(cuid())
  code  String                @unique
  scope MissionChecklistScope
  label String
  order Int
  // Offre minimale qui couvre cet item — c'est LE référentiel du filtrage par
  // offre (context/07-outil-pilotage-missions.md §12.4). Aucun code d'item n'est
  // codé en dur dans un service : la règle se change en base, pas en TypeScript.
  // ESSENTIEL = couvert par toutes les formules. BETA (bêta-test gratuit) reçoit
  // le périmètre EXCELLENCE, cf. offer-scope-service.getEffectiveTier().
  minFormule CommercialTier @default(ESSENTIEL) @map("min_formule")

  statuses MissionChecklistItemStatus[]

  @@map("mission_checklist_items")
}

// Une mission par établissement — enregistrement du périmètre commercial
// effectivement contracté (formule + gratuit) et de la progression de
// l'accompagnement. La formule ici fait autorité pour le calcul de scope
// Excellence (§7.3) — Establishment.commercialTier reste inchangé.
model Mission {
  id              String         @id @default(cuid())
  tenantId        String         @map("tenant_id")
  establishmentId String         @unique @map("establishment_id")
  formule         CommercialTier
  // Bêta-test gratuit — cf. §7.5 : accorde le périmètre Excellence complet
  // indépendamment de `formule` (condition OR, jamais écrasée par formule).
  gratuit         Boolean        @default(false)

  fondationsStartDate        DateTime? @map("fondations_start_date")
  fondationsEndDate          DateTime? @map("fondations_end_date")
  deploiementStartDate       DateTime? @map("deploiement_start_date")
  deploiementEndDate         DateTime? @map("deploiement_end_date")
  consolidationStartDate     DateTime? @map("consolidation_start_date")
  consolidationEndDate       DateTime? @map("consolidation_end_date")
  preparationFinaleStartDate DateTime? @map("preparation_finale_start_date")
  preparationFinaleEndDate   DateTime? @map("preparation_finale_end_date")

  // Clôture de la mission. SEUL fait du cycle de vie qui ne se dérive pas : c'est une
  // décision de l'évaluatrice, pas un calcul. Déduire « terminé » d'une checklist à
  // 100 % serait faux — une mission entièrement cochée reste ouverte jusqu'à la visite
  // des évaluateurs HAS. Tout le reste de l'état (SIGNE / EN_COURS) se calcule à partir
  // des faits existants, cf. lib/services/lifecycle-service.ts.
  closedAt DateTime? @map("closed_at")

  // Révocation de l'accès CLIENT après la fin de mission. Seconde décision non
  // dérivable : une mission close laisse par défaut au client sa bibliothèque en
  // lecture seule (§12.5, position finale du call du 16/08 — « on ne coupe pas leur
  // accès, on leur préconise de s'abonner »). Couper est un geste explicite, jamais
  // un effet de bord de la clôture.
  //
  // Aucune donnée n'est supprimée : la rétention reste côté cabinet. Réversible —
  // reposer ce champ à null rend la bibliothèque.
  clientAccessRevokedAt DateTime? @map("client_access_revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Devis qui a produit cette mission à la signature. Trace, jamais source de
  // vérité : le périmètre reste porté par `formule` + `gratuit` ci-dessus
  // (CLAUDE.md §7 — la décision contractuelle vit sur Mission). Nullable : les
  // missions créées à la main avant la conversion automatique n'en ont pas.
  sourceDevisId String? @map("source_devis_id")

  tenant        Tenant                       @relation(fields: [tenantId], references: [id])
  // Cascade : une mission n'existe que par son établissement.
  establishment Establishment                @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  sourceDevis   Devis?                       @relation(fields: [sourceDevisId], references: [id])
  itemStatuses  MissionChecklistItemStatus[]
  options       MissionOption[]

  @@index([tenantId])
  // Déclaré ici après coup : l'index existe en base depuis la migration
  // `20260820210000_prospect_conversion`, mais le schéma l'ignorait. Une dérive
  // silencieuse dans ce sens est bénigne — l'index est là — mais elle rendait le
  // schéma faux, et le prochain `db pull` l'aurait « corrigé » en le supprimant.
  @@index([sourceDevisId])
  @@map("missions")
}

// Option souscrite, portée par la MISSION. Le devis reste le document commercial
// (il fait contrat et ne se réécrit jamais) ; la mission, elle, est ce qui gouverne
// le périmètre réellement ouvert au client — CLAUDE.md §7 : la décision
// contractuelle vit sur Mission, jamais sur Establishment.commercialTier. Sans
// cette table, le périmètre d'options n'était lisible qu'en remontant
// Establishment → Prospect → Devis, un chemin qui casse dès qu'un établissement
// n'a pas de prospect (limite connue du §12.6).
//
// Les colonnes sont des SNAPSHOTS, recopiés depuis le devis à la signature : une
// évolution du catalogue ne doit pas réécrire un périmètre déjà contracté.
model MissionOption {
  id                String @id @default(cuid())
  missionId         String @map("mission_id")
  catalogueOptionId String @map("catalogue_option_id")

  labelSnapshot         String      @map("label_snapshot")
  priceSnapshotEuros    Int         @map("price_snapshot_euros")
  pricingUnitSnapshot   PricingUnit @default(FORFAIT) @map("pricing_unit_snapshot")
  priceMaxSnapshotEuros Int?        @map("price_max_snapshot_euros")
  minQuantitySnapshot   Int?        @map("min_quantity_snapshot")

  // Nature du montant ci-dessus, et non un détail d'affichage.
  //
  // true  — l'option vient d'un devis SIGNÉ : le montant est FERME, il fait contrat.
  // false — l'option a été rattachée à la main par le cabinet au périmètre de la
  //         mission, sans devis. Le montant est alors recopié du catalogue, où il
  //         est un « à partir de » : l'afficher comme ferme reviendrait à inventer
  //         un contrat côté portail client (CLAUDE.md §7 — les deux natures de prix
  //         ne doivent jamais être rendues pareil).
  //
  // Défaut `true` volontaire : toutes les lignes existantes proviennent de
  // convertDevisToClient, donc d'un devis signé. La migration n'a rien à recalculer.
  priceIsFirm Boolean @default(true) @map("price_is_firm")

  // SIGNATURE DE L'AVENANT qui régularise cette option.
  //
  // L'avenant se GÉNÉRAIT sans que rien ne dise s'il était revenu signé : Sandrine
  // devait s'en souvenir, ou rouvrir sa boîte mail. Ce champ est ce fait, et rien de
  // plus — il ne rend PAS le montant ferme : l'avenant porte un « à partir de »
  // recopié du catalogue (avenant-service), le signer ne le transforme pas en prix
  // négocié. `priceIsFirm` reste la PROVENANCE (devis signé), ce champ la
  // RÉGULARISATION. Les confondre ferait afficher au client un engagement que
  // personne n'a chiffré.
  //
  // Conséquence : une option régularisée ne se retire plus depuis l'écran de mission,
  // exactement comme une option issue d'un devis — un document signé ne s'annule pas
  // en décochant une case.
  avenantSignedOn DateTime? @map("avenant_signed_on")

  createdAt DateTime @default(now()) @map("created_at")

  // Cascade : une option souscrite n'existe que par sa mission. Sans cette règle
  // portée par la BASE, chaque nouvelle relation oblige à penser à la supprimer à la
  // main dans deleteEstablishment — et celle-ci avait justement été oubliée, faisant
  // échouer toute suppression d'établissement converti (P2003).
  mission         Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  catalogueOption CatalogueOption @relation(fields: [catalogueOptionId], references: [id])

  // Contrainte qui rend la conversion IDEMPOTENTE côté options : rejouer la
  // signature ne peut pas doubler une ligne. Le code s'appuie dessus
  // (`createMany({ skipDuplicates: true })`), il ne la réimplémente pas.
  @@unique([missionId, catalogueOptionId])
  @@index([catalogueOptionId])
  @@map("mission_options")
}

// Case cochée pour un item donné d'une mission donnée. Absence de ligne = non
// coché (même idiome que Document/DocumentType : pas de ligne créée tant que
// l'item n'a jamais été touché).
model MissionChecklistItemStatus {
  id          String    @id @default(cuid())
  missionId   String    @map("mission_id")
  itemId      String    @map("item_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")

  // Cascade : un statut de checklist n'a pas de vie hors de sa mission.
  mission Mission              @relation(fields: [missionId], references: [id], onDelete: Cascade)
  item    MissionChecklistItem @relation(fields: [itemId], references: [id])

  @@unique([missionId, itemId])
  @@index([itemId])
  @@map("mission_checklist_item_statuses")
}

// ─────────────────────────────────────────────────────────────────────────────
// FIL D'ÉCHANGE MISSION ↔ CLIENT — CDC §5 « messagerie / échanges »
//
// « Fil d'échange léger consultante ↔ client rattaché à la mission, pour limiter les
// allers-retours par e-mail. » Léger est le mot : un fil par établissement, pas de
// pièce jointe (les documents ont leur propre dépôt, versionné et analysé), pas de
// conversation par document.
//
// APPEND-ONLY, comme `ProspectTimelineEntry` et pour la même raison : un échange
// réécrivable ne prouve rien le jour où il faut expliquer ce qui avait été demandé,
// et quand. Ni modification, ni suppression.
// ─────────────────────────────────────────────────────────────────────────────

enum MessageAuthorSide {
  CABINET
  CLIENT
}

model MissionMessage {
  id              String            @id @default(cuid())
  tenantId        String            @map("tenant_id")
  establishmentId String            @map("establishment_id")
  authorUserId    String            @map("author_user_id")
  // Côté FIGÉ à l'écriture, et non déduit du rôle de l'auteur à la lecture : un
  // compte peut changer de rôle, et le fil doit continuer de dire qui parlait au nom
  // de qui ce jour-là.
  authorSide      MessageAuthorSide @map("author_side")
  body            String
  createdAt       DateTime          @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  // Cascade : le fil n'existe que par l'établissement. La rétention porte sur les
  // documents et le journal d'audit, pas sur une conversation.
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  author        User          @relation(fields: [authorUserId], references: [id])

  @@index([establishmentId, createdAt])
  @@index([tenantId])
  @@map("mission_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// JOURNAL D'AUDIT — traçabilité des accès aux données sensibles
// cf. specs/03-roadmap-developpement.md Jalon 5 et specs/02-architecture-technique.md §Sécurité
//
// Données de santé/social : il faut pouvoir répondre à « qui a consulté ou déposé
// quel document, et quand ». Table volontairement en append-only, SANS clé
// étrangère vers User/Establishment : un journal d'audit ne doit pas être effacé
// en cascade avec l'objet qu'il documente (la suppression d'un établissement est
// précisément un événement dont on veut garder la trace). Les identifiants sont
// donc conservés comme valeurs, pas comme relations.
// ─────────────────────────────────────────────────────────────────────────────

enum AuditAction {
  DOCUMENT_UPLOADED
  DOCUMENT_DOWNLOADED
  DOCUMENT_PREVIEWED
  DOCUMENT_STATUS_ANSWERED
  CLIENT_USER_INVITED
  ESTABLISHMENT_DELETED
  LOGIN_FAILED
  LOGIN_RATE_LIMITED
  PASSWORD_CHANGED
  PASSWORD_CHANGE_FAILED
  PASSWORD_CHANGE_RATE_LIMITED
  // Opérations destructrices du module commercial (CABINET_ADMIN uniquement).
  // `targetId` = identifiant du devis / de la ligne de catalogue, `detail` = son
  // numéro ou son code : clés techniques, jamais une donnée personnelle.
  DEVIS_DELETED
  DEVIS_CANCELLED
  CATALOGUE_ITEM_RETIRED
  CATALOGUE_ITEM_RESTORED
  // Révocation d'accès et cycle de vie d'un compte (audit CRUD du 20/08/2026).
  // `targetId` = identifiant technique du compte visé, jamais son email ni son nom.
  CLIENT_USER_UNLINKED
  CLIENT_USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_DELETED_WITH_ESTABLISHMENT
  // Bibliothèque de modèles EODA (CABINET_ADMIN uniquement). `targetId` = identifiant
  // technique du modèle ou de la version, `detail` = son libellé de version — jamais
  // le nom d'un fichier, qui peut porter un nom de structure.
  TEMPLATE_VERSION_UPLOADED
  TEMPLATE_VERSION_DELETED
  TEMPLATE_DOCUMENT_DELETED
  PASSWORD_RESET_BY_ADMIN
  LOGIN_REFUSED_INACTIVE
  // Demande de devis d'option depuis le portail client (§12.3 / §12.6).
  // `targetId` = identifiant de la ligne de catalogue visée, `detail` = son code.
  OPTION_QUOTE_REQUESTED
  OPTION_REQUEST_HANDLED
  // Signature d'un devis → création de la fiche client et du profil (§12.4).
  // `targetId` = identifiant du devis signé, `detail` = son numéro et la formule
  // ouverte : deux clés techniques, jamais une donnée nominative.
  PROSPECT_CONVERTED
  // Périmètre d'une mission modifié à la main par le cabinet (formule, options),
  // hors signature de devis. `targetId` = identifiant de la mission, `detail` =
  // la formule et le nombre d'options : des clés techniques, jamais un nom.
  MISSION_SCOPE_UPDATED
  // Cycle de vie d'une version de document
  DOCUMENT_VERSION_DELETED
  DOCUMENT_JUSTIFICATION_UPDATED
  // Fin de mission (§12.5). `targetId` = identifiant de la mission. Ces quatre
  // gestes ouvrent ou ferment l'accès d'un client à ses propres documents : ils
  // sont les plus sensibles du module et doivent laisser une trace datée et
  // nominative côté acteur — jamais côté personne accompagnée.
  MISSION_CLOSED
  MISSION_REOPENED
  MISSION_CLIENT_ACCESS_REVOKED
  MISSION_CLIENT_ACCESS_RESTORED
  // Revue humaine d'une analyse automatique avant restitution au client (CDC §5,
  // §7). `targetId` = identifiant de la version de document.
  ANALYSIS_PUBLISHED
  ANALYSIS_UNPUBLISHED
  // Validation finale d'un document par le cabinet (parcours documentaire, 26/08).
  DOCUMENT_VALIDATED
  DOCUMENT_UNVALIDATED
  // Un type de document passe de « réclamé au client » à « produit par EODA », ou
  // l'inverse. Politique de cabinet, valable pour tous les clients.
  DOCUMENT_TYPE_SCOPE_CHANGED
  // Export des cotations d'auto-évaluation (fichier tableur). Un export SORT les
  // données de la plateforme : c'est précisément le genre d'accès dont il faut
  // pouvoir dire qui, quand, et pour quel établissement.
  EVALUATION_EXPORTED
  // Retour d'un avenant signé, et retrait de cette signature. `targetId` =
  // identifiant de la ligne MissionOption, `detail` = le libellé de la prestation
  // (donnée de catalogue, jamais nominative). Ces deux gestes verrouillent ou
  // déverrouillent le retrait d'une prestation du périmètre d'un client.
  AVENANT_SIGNED
  AVENANT_SIGNATURE_CLEARED
  // Relance des pièces manquantes envoyée aux interlocuteurs d'une structure.
  // `detail` = le nombre de pièces et de destinataires, jamais leurs adresses.
  DOCUMENT_REMINDER_SENT
}

model AuditLogEntry {
  id              String      @id @default(cuid())
  occurredAt      DateTime    @default(now()) @map("occurred_at")
  action          AuditAction
  // null pour un événement non authentifié (échec de connexion sur un email inconnu).
  actorUserId     String?     @map("actor_user_id")
  actorRole       String?     @map("actor_role")
  establishmentId String?     @map("establishment_id")
  // Identifiant de l'objet visé (DocumentVersion, User invité…) — jamais une donnée
  // personnelle, uniquement une clé technique.
  targetId        String?     @map("target_id")
  // Contexte court et non nominatif (nom de type de document, motif de refus).
  detail          String?

  @@index([establishmentId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  // Consultation par défaut : tout le périmètre, du plus récent au plus ancien,
  // paginée. Les index composites ci-dessus commencent par une colonne de filtre et
  // ne servent pas ce tri.
  @@index([occurredAt])
  @@map("audit_log_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPTEUR DE LIMITATION DE DÉBIT PARTAGÉ
//
// Ajouté le 21/08/2026 avec la bascule du déploiement sur Vercel. En serverless,
// un compteur en mémoire de processus ne protège de rien : chaque invocation peut
// tomber sur une autre instance et un démarrage à froid le remet à zéro. Le
// compteur vit donc dans la seule ressource partagée par toutes les instances.
//
// Une ligne par clé (`login:<ip>:<email>`), fenêtre fixe ancrée sur la première
// tentative. L'écriture passe par un `INSERT … ON CONFLICT DO UPDATE … RETURNING`
// écrit à la main (`apps/web/src/lib/security/prisma-rate-limit-store.ts`) : c'est
// lui qui rend l'incrément atomique sous concurrence. Prisma sert ici à la
// lecture (`peek`) et à l'effacement (`reset`) uniquement.
//
// Table sans données personnelles au sens strict, mais la clé contient une IP et
// un email : elle est purgée en continu (lignes échues supprimées
// opportunistement à l'écriture), jamais conservée au-delà de la fenêtre.
// ─────────────────────────────────────────────────────────────────────────────
model RateLimitCounter {
  // La clé applicative EST la clé primaire : c'est ce qui donne au `ON CONFLICT`
  // l'index unique dont il a besoin, sans colonne technique en plus.
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime @map("expires_at")

  // Sert la purge des lignes échues (DELETE … WHERE expires_at <= now).
  @@index([expiresAt])
  @@map("rate_limit_counters")
}

// ─────────────────────────────────────────────────────────────────────────────
// BIBLIOTHÈQUE DE MODÈLES EODA
//
// « Est-ce qu'on pourrait avoir un endroit dans le portail où j'uploade les versions
// vierges ? […] S'il faut une nouvelle version avec un nouvel article de loi, que
// j'y aille directement, que je crée une version 1.2, une version 1.3. Je ne pourrai
// pas garder tout ça sur mon PC à un moment donné » (call du 01/09).
//
// ⚠️ À NE PAS confondre avec `Document` / `DocumentVersion`, qui sont les pièces
// D'UNE STRUCTURE. Ici, rien n'appartient à un établissement : ce sont les gabarits
// d'EODA, son propre matériau de travail, et ils sont réservés au cabinet. Les
// fusionner obligerait à rattacher chaque modèle à un client fictif et ferait entrer
// des gabarits internes dans les checklists et les livrables clients.
// ─────────────────────────────────────────────────────────────────────────────

// Trois états du même document, tels que Sandrine les nomme et les envoie. Ce n'est
// pas une chronologie de rédaction mais trois usages distincts : le gabarit qu'on
// réutilise, l'état reçu, le résultat produit. C'est cette distinction qui donnera
// son intérêt à l'entraînement de l'IA — comparer un avant et un après.
enum TemplateStage {
  // Gabarit sans données : ce qui sert de base à une nouvelle structure.
  VIERGE
  // État reçu de la structure, avant intervention.
  INITIALE
  // Version produite par EODA, celle qui est restituée.
  FINALE
}

model TemplateDocument {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  title    String
  // Même catégorisation que la checklist documentaire : la bibliothèque se range
  // comme les pièces qu'elle sert à produire. Pas de lien vers `DocumentType` pour
  // l'instant — beaucoup de gabarits sont des outils internes qui ne correspondent à
  // aucune pièce attendue, et une clé étrangère que rien ne lit serait spéculative.
  category    DocumentCategory
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  versions TemplateVersion[]

  // Un même titre deux fois dans la bibliothèque, ce sont deux fiches qui divergent :
  // l'une reçoit les mises à jour, l'autre est oubliée.
  @@unique([tenantId, title])
  @@map("template_documents")
}

model TemplateVersion {
  id                 String @id @default(cuid())
  templateDocumentId String @map("template_document_id")
  // Libellé décidé par la consultante (« v1.2 »), et pas un compteur : c'est elle qui
  // sait si une correction est une révision mineure ou une refonte. Un numéro
  // incrémenté par la machine ne dirait rien de la portée du changement.
  versionLabel String        @map("version_label")
  stage        TemplateStage
  // Ce qui a changé — « ajout de l'article L.311-8 ». Sans cette note, une v1.3 ne se
  // distingue d'une v1.2 que par sa date.
  changeNote String? @map("change_note")

  fileStorageKey   String @map("file_storage_key")
  originalFilename String @map("original_filename")
  contentType      String @map("content_type")
  sizeBytes        Int    @map("size_bytes")

  uploadedByUserId String   @map("uploaded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  templateDocument TemplateDocument @relation(fields: [templateDocumentId], references: [id], onDelete: Cascade)
  uploadedBy       User             @relation("TemplateUploadedBy", fields: [uploadedByUserId], references: [id])

  // Le même libellé ne peut pas désigner deux fichiers différents au même stade.
  @@unique([templateDocumentId, stage, versionLabel])
  @@map("template_versions")
}
