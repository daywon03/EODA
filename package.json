{
  "name": "eoda-platform",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "sharp",
      "prisma"
    ],
    "overrides": {
      "brace-expansion": ">=5.0.9",
      "browserslist": ">=4.28.7",
      "js-yaml": ">=4.3.0",
      "nanoid": ">=3.3.16",
      "postcss": ">=8.5.12",
      "sharp": ">=0.35.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-4r6h-8v6p-xvw6",
        "GHSA-5pgg-2g8v-p4x9"
      ]
    }
  },
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks || true && pnpm --filter @eoda/database generate",
    "dev": "pnpm --filter @eoda/web dev",
    "build": "pnpm --filter @eoda/web build",
    "lint": "pnpm --filter @eoda/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @eoda/web test",
    "db:generate": "pnpm --filter @eoda/database generate",
    "db:migrate:dev": "pnpm --filter @eoda/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @eoda/database migrate:deploy",
    "db:seed": "pnpm --filter @eoda/database seed",
    "db:studio": "pnpm --filter @eoda/database studio",
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "verify:prod-config": "pnpm --filter @eoda/web verify:prod-config"
  }
}
